# ─────────────────────────────────────────────────────────────
#  AMBICA ALUM INDUSTRIES — BACKEND ENVIRONMENT CONFIG
#  Copy this file to .env and fill in your real values.
#  NEVER commit the real .env to Git.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development        # change to "production" on server

# ── MongoDB Atlas ────────────────────────────────────────────
# Local dev:
# MONGO_URI=mongodb://127.0.0.1:27017/ambica
# Production (Atlas):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ambica?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
# Use a long, random string in production. Min 32 chars.
JWT_SECRET=REPLACE_WITH_A_VERY_LONG_RANDOM_SECRET_STRING

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list — add your Vercel/Netlify URL here
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://your-app.vercel.app

# ── Email (Nodemailer) ───────────────────────────────────────
# Used for order confirmation / quote received emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password      # Use Gmail App Password, NOT your login password
EMAIL_FROM=Ambica Alum Industries <no-reply@ambicaalum.com>

# ── Cloudinary (Image Uploads) ───────────────────────────────
# Sign up free at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
